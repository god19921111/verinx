# ============================================================
# VerinX公考AI全真面试模拟 · 后端生产环境配置模板
# 使用前复制为 .env.production 并填写真实值
# ============================================================

# ---------- 应用 ----------
APP_NAME=VerinX公考AI全真面试模拟
APP_VERSION=0.1.0
DEBUG=False

# ---------- 数据库（docker-compose 中自动覆盖，本地开发用此值）----------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gongkaoxing

# ---------- Redis（docker-compose 中自动覆盖）----------
REDIS_URL=redis://localhost:6379/0

# ---------- JWT 认证 ----------
# 生产环境必须更换为随机字符串（至少32位），可用：openssl rand -hex 32
JWT_SECRET_KEY=请替换为随机密钥
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# ---------- 文件上传 ----------
UPLOAD_DIR=/app/uploads
AUDIO_MAX_SIZE_MB=10
VIDEO_MAX_SIZE_MB=50
# 免费用户文件保留天数
FREE_USER_FILE_RETENTION_DAYS=7
# 会员文件保留天数
PREMIUM_USER_FILE_RETENTION_DAYS=30

# ---------- 会员权限 ----------
FREE_DAILY_PRACTICE_LIMIT=5
FREE_FOLLOW_UP_LIMIT=1
PREMIUM_FOLLOW_UP_LIMIT=3
MAX_FOLLOW_UP_PER_SESSION=3

# ---------- 评分权重（权重和必须=1.0）----------
SCORE_WEIGHT_ANALYSIS=0.25
SCORE_WEIGHT_EXPRESSION=0.20
SCORE_WEIGHT_ADAPTABILITY=0.20
SCORE_WEIGHT_ORGANIZATION=0.20
SCORE_WEIGHT_APPEARANCE=0.15

# ---------- 第三方 AI 服务 ----------
# TTS 语音合成（如阿里云语音合成、讯飞TTS）
TTS_API_KEY=
TTS_API_URL=

# ASR 语音识别（如阿里云语音识别、讯飞ASR）
ASR_API_KEY=
ASR_API_URL=

# LLM 大语言模型（如通义千问、ChatGLM、GPT）
LLM_API_KEY=
LLM_API_URL=
LLM_MODEL=

# ---------- 短信验证码 ----------
# MVP阶段设为 False，使用模拟验证码（接口直接返回验证码）
# 生产环境设为 True 并配置短信服务
SMS_ENABLED=False
SMS_API_KEY=
SMS_API_URL=
