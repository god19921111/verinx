# ============================================================
# VerinX · Render 部署配置
# 平台：Render (https://render.com) 免费版 Web Service
# 配置：512MB RAM + 自动 HTTPS + Git 自动部署
# 说明：前后端整合部署，SQLite 数据库，无需外部服务
# ============================================================

# ---- 阶段1: 构建前端 ----
FROM node:20-alpine AS frontend-builder

WORKDIR /build

# 先复制依赖文件，利用 Docker 层缓存
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install --legacy-peer-deps

# 复制前端源码并构建
COPY frontend/ .
# 构建时使用相对路径 /api，适配同端口部署
ENV VITE_API_BASE_URL=/api
RUN npm run build

# ---- 阶段2: 后端 + 前端静态文件 ----
FROM python:3.11-slim

# 系统依赖（ffmpeg 用于音视频处理）
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    libsndfile1 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 安装 Python 依赖（精简版，不含 funasr/torch 等重型依赖）
COPY backend/requirements-deploy.txt .
RUN pip install --no-cache-dir -r requirements-deploy.txt

# 复制后端代码
COPY backend/ .

# 复制前端构建产物到 /frontend/dist
# (main.py 中 FRONTEND_DIST 路径: parent.parent.parent / "frontend" / "dist")
# 后端代码在 /app/app/, 所以 parent.parent.parent = /, 即 /frontend/dist
COPY --from=frontend-builder /build/dist /frontend/dist

# 创建数据目录
RUN mkdir -p /data/uploads

# ---------- 环境变量配置 ----------
# Render 会自动注入 PORT 环境变量
ENV DEBUG=False
ENV DATABASE_URL=sqlite:////data/verinx.db
ENV UPLOAD_DIR=/data/uploads
ENV JWT_SECRET_KEY=verinx-render-secret-change-me
ENV JWT_ALGORITHM=HS256
ENV JWT_EXPIRE_MINUTES=120

# 会员权限
ENV FREE_DAILY_PRACTICE_LIMIT=3
ENV FREE_FOLLOW_UP_LIMIT=1
ENV PREMIUM_FOLLOW_UP_LIMIT=3

# 文件保留策略
ENV FREE_USER_FILE_RETENTION_DAYS=7
ENV PREMIUM_USER_FILE_RETENTION_DAYS=30

# 题库自动同步
ENV QUESTION_BANK_AUTO_SYNC=True
ENV QUESTION_BANK_SYNC_INTERVAL_HOURS=24

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT:-10000}/api/health || exit 1

# 启动命令：Render 会注入 PORT 环境变量（默认 10000）
CMD sh -c "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"
