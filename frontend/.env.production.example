# ============================================================
# VerinX · 前端生产环境变量
# 部署到 Vercel 时，在项目设置 → Environment Variables 中配置
# ============================================================

# 后端 API 地址（Render 部署后的域名）
# 示例：https://verinx-api.onrender.com/api
VITE_API_BASE_URL=https://your-backend-url.onrender.com/api
